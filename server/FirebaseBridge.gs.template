    var oldStudents=original.filter(function(t){return t.name==='학생';})[0];
    Object.keys(oldStudents.cells).forEach(function(key){if(!/:9$/.test(key))return;var token=String(oldStudents.cells[key].value||'').trim().toLowerCase();if(/^[0-9a-f]{32,128}$/.test(token)&&!documents['links/'+token])deleted.push('links/'+token);});
    var settings=store.getSheetByName('설정'),rows=settings.getRange(2,1,Math.max(1,settings.getLastRow()-1),2).getValues(),pin='1234';
    rows.forEach(function(r){if(String(r[0]).trim()==='선생님비밀번호')pin=String(r[1]).trim();});documents['credentials/teacher']={role:'teacher',pinHash:fbHash_(pin)};
  }
