    identities=[];var s=store.getSheetByName('학생');
    for(var row=2;row<=s.getLastRow();row++){
      var r=s.getRange(row,1,1,Math.max(11,s.getLastColumn())).getValues()[0],name=String(r[1]||'').trim();if(!name)continue;
      var old=catalog.identities.filter(function(i){return i.row===row;})[0],id=old?old.id:'student-'+Utilities.getUuid();
      identities.push({id:id,name:name,row:row});documents['credentials/'+id]={role:'student',name:name,row:row,pinHash:fbHash_(String(r[2]===undefined?'':r[2]).trim())};
