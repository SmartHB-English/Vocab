    var read=body.transaction.reads,touched={},writes=body.writes.map(function(write){
      var name=write.update?write.update.name:write.delete;touched[name]=true;
      return Object.assign({},write,{currentDocument:read[name]||{exists:false}});
    });
    Object.keys(read).forEach(function(name){if(!touched[name])writes.push({verify:name,currentDocument:read[name]});});
    body={writes:writes};
  }
  return fbHttp_(base+suffix,'post',body,auth.idToken);
}
function fbRead_(auth,paths,transaction) {
  var prefix='projects/'+FB_BRIDGE_CONFIG.project+'/databases/(default)/documents/';
  var body={documents:paths.map(function(p){return prefix+'vocabDatasets/'+FB_BRIDGE_CONFIG.dataset+'/'+p;})};
  if(transaction&&transaction.readTime)body.readTime=transaction.readTime;
  var replies=fbDatabase_(auth,':batchGet',body),out={};
  replies.forEach(function(r){
    if(transaction){if(!transaction.readTime&&r.readTime)transaction.readTime=r.readTime;
      if(r.found)transaction.reads[r.found.name]={updateTime:r.found.updateTime};
      if(r.missing)transaction.reads[r.missing]={exists:false};}
    if(r.found){var relative=r.found.name.slice((prefix+'vocabDatasets/'+FB_BRIDGE_CONFIG.dataset+'/').length);out[relative]=VocabBridgeCore.fromField({mapValue:{fields:r.found.fields||{}}});}});
