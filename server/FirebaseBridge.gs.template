  var phase=fbPhase_(),native=fbNativeEngine_(),local=native.call('시작정보',[]),remote=fbRequest_('시작정보',[]);
  Logger.log(JSON.stringify({phase:phase,dataset:FB_BRIDGE_CONFIG.dataset,startInfoMatches:JSON.stringify(local)===JSON.stringify(remote)}));
}

function firebaseMigrationDrain(){
  var lock=LockService.getScriptLock();lock.waitLock(30000);
  try{Logger.log(JSON.stringify({legacyWritesDrained:true}));}finally{lock.releaseLock();}
}
