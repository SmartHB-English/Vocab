}
function fbBridgeProof_(){
  var props=PropertiesService.getScriptProperties(),proof=props.getProperty('FB_BRIDGE_PROOF_V1');if(proof)return proof;
  var sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('설정'),pin='1234';
  sheet.getDataRange().getValues().forEach(function(row){if(String(row[0]).trim()==='선생님비밀번호')pin=String(row[1]).trim();});
  proof=fbHash_(pin);props.setProperty('FB_BRIDGE_PROOF_V1',proof);return proof;
}
function fbSession_(auth) {
  var C=VocabBridgeCore;
  var name='projects/'+FB_BRIDGE_CONFIG.project+'/databases/(default)/documents/sessions/'+auth.uid;
  fbHttp_('https://firestore.googleapis.com/v1/'+name,'patch',{fields:C.toField({dataset:FB_BRIDGE_CONFIG.dataset,credentialId:'bridge',proof:fbBridgeProof_()}).mapValue.fields},auth.idToken);
}
function fbDatabase_(auth,suffix,body) {
