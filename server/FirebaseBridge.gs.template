  documents['meta/catalog']=Object.assign({},catalog,{tables:metadata,identities:identities,revision:fn==='학부모보기'?catalog.revision:requestId});
  documents['journal/'+requestId]={actor:auth.uid,fn:fn,result:C.pack(answer),changes:changes,at:Date.now()};
  tables.forEach(function(t){if(t.dirty)documents['journal/'+requestId+'/tables/'+C.sheetId(t.name)]={payload:C.pack(t.export())};});
  deleted=deleted.filter(function(path,index,all){return !documents[path]&&all.indexOf(path)===index;});
