function fbHash_(text) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(text),Utilities.Charset.UTF_8)
    .map(function(x){return ('0'+((x+256)%256).toString(16)).slice(-2);}).join('');
}
function fbHttp_(url,method,body,token) {
  var options={method:method,contentType:'application/json',muteHttpExceptions:true};
  if(body!==undefined)options.payload=JSON.stringify(body);
  if(token)options.headers={Authorization:'Bearer '+token};
  var response=UrlFetchApp.fetch(url,options),status=response.getResponseCode();
  var value=JSON.parse(response.getContentText()||'{}');
  if(status<200||status>=300) { var e=new Error('자료 서버 요청에 실패했습니다. 잠시 후 다시 해 주세요. ('+status+')');e.status=status;e.retryable=value.error&&['ABORTED','FAILED_PRECONDITION'].indexOf(value.error.status)>=0;throw e; }
