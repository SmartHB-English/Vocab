      var r=fbImageFile_(args[1],args[2],args[3],args[4]);fbDatabase_(auth,':rollback',{transaction:tx});return r;
    }
    if(fn==='푸시전송'){fbDatabase_(auth,':rollback',{transaction:tx});return engine.call(fn,args);}
    var answer=fn==='__월시상'?engine.monthly():engine.call(fn,args);fbSave_(auth,store,catalog,tx,fn,original,answer);return answer;
  }catch(e){try{fbDatabase_(auth,':rollback',{transaction:tx});}catch(ignore){}throw e;}
}
