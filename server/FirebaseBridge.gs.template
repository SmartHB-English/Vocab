}
function fbWrites_(documents,deleted) {
  var prefix='projects/'+FB_BRIDGE_CONFIG.project+'/databases/(default)/documents/vocabDatasets/'+FB_BRIDGE_CONFIG.dataset+'/';
  var C=VocabBridgeCore,writes=[];
  Object.keys(documents).forEach(function(path){writes.push({update:{name:prefix+path,fields:C.toField(documents[path]).mapValue.fields}});});
  (deleted||[]).forEach(function(path){writes.push({delete:prefix+path});});
  return writes;
}
function fbSave_(auth,store,catalog,transaction,fn,original,answer) {
  var C=VocabBridgeCore,documents={},deleted=[],tables=store.getSheets(),metadata=[],changes=[];
  tables.forEach(function(table,position){
    var old=catalog.tables.filter(function(m){return m.name===table.name;})[0];
    if(!table.dirty){metadata.push(old);return;}
    var full=table.export(),visible=C.publicTable(full),payload=C.pack(visible),version=fbHash_(payload);
    if(Utilities.newBlob(payload).getBytes().length>850000)throw new Error('자료가 커서 나누어 저장해야 합니다.');
    var meta=Object.assign(C.tableMetadata(full,position),{version:version});
    documents['tables/'+C.sheetId(full.name)]={payload:payload,version:version,name:full.name,public:['학생','설정','단어장목록','공지'].indexOf(full.name)>=0||full.name.indexOf('단어_')===0};
    if(['학생','설정'].indexOf(full.name)>=0){
      var cells={};Object.keys(full.cells).forEach(function(k){if(C.pack(full.cells[k])!==C.pack(visible.cells[k]))cells[k]=full.cells[k];});
