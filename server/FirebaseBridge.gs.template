doPost = function(e){
  var reply;
  try{var request=JSON.parse(e&&e.postData&&e.postData.contents||'{}');if(FB_RPC_NAMES.indexOf(String(request.fn||'').trim())<0&&request.fn!=='__그림파일')throw new Error('쓸 수 없는 기능입니다: '+request.fn);reply={ok:true,값:fbDispatch_(String(request.fn||'').trim(),request.args||[])};}
  catch(err){reply={ok:false,메시지:String(err&&err.message||err)};}
  return ContentService.createTextOutput(JSON.stringify(reply)).setMimeType(ContentService.MimeType.JSON);
};

