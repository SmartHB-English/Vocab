    var effects={cache:cache,Utilities:{formatDate:function(d,z,f){return Utilities.formatDate(d,z,f);},base64Decode:function(x){return Utilities.base64Decode(x);},newBlob:function(){return Utilities.newBlob.apply(Utilities,arguments);}},PropertiesService:PropertiesService,DriveApp:DriveApp,UrlFetchApp:UrlFetchApp,ScriptApp:ScriptApp};
