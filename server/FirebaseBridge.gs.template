}
function fbRequest_(fn,args){
  var request={now:Date.now(),ids:[],images:{}};
  for(var attempt=0;attempt<3;attempt++){
    try{return fbRequestOnce_(fn,args,request);}catch(e){if(!e.retryable||attempt===2)throw e;}
  }
}
function fbRequestOnce_(fn,args,request) {
  var C=VocabBridgeCore,auth=fbAuth_();fbSession_(auth);
